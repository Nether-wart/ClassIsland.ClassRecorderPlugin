<ci:SettingsPageBase x:Class="ClassIsland.ClassRecorderPlugin.Views.SettingsPages.ClassRecorderSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:vm="clr-namespace:ClassIsland.ClassRecorderPlugin.ViewModels"
                     x:DataType="vm:ClassRecorderSettingsViewModel"
                     x:CompileBindings="True"
                     mc:Ignorable="d"
                     d:DesignHeight="720"
                     d:DesignWidth="900">
    <ScrollViewer>
        <StackPanel Margin="32" Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">

            <!-- 运行状态 -->
            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="运行状态" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" IsVisible="{Binding ShowStatusText}" />
                    <TextBlock Text="{Binding RecordingTargetText}"
                               IsVisible="{Binding IsRecording}"
                               Opacity="0.8" />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasNoMicrophone}">
                        <TextBlock Text="未找到可用麦克风"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Content="重试" Command="{Binding RetryMicrophoneCommand}" />
                    </StackPanel>
                    <TextBlock Text="尚未选择要录制的课程，不会自动录音。"
                               Opacity="0.7"
                               IsVisible="{Binding ShowNoSubjectHint}" />
                </StackPanel>
            </Border>

            <!-- 课程选择 -->
            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="要录制的课程" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.7"
                               Text="勾选需要自动录制的科目。同一科目的所有课程都会录音；未勾选任何科目时不会录音。" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="全选" Command="{Binding SelectAllSubjectsCommand}" />
                        <Button Content="清空" Command="{Binding ClearSubjectsCommand}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Subjects}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SubjectSelectionItem">
                                <CheckBox Margin="0 0 20 0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Content="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" IsVisible="{Binding HasNoSubjects}"
                               Text="当前课表中还没有科目，请先在「课表」中配置课程。" />
                </StackPanel>
            </Border>

            <!-- 保存位置 -->
            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="保存位置" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.7"
                               Text="录音将保存为：目录/年/月/日/课程名称-上课时间(HH_mm).扩展名" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 Text="{Binding AudioRoot, Mode=TwoWay}"
                                 Watermark="录音保存目录" />
                        <Button Grid.Column="1" Content="浏览…" Click="BrowseButton_OnClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 录制时间 -->
            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="录制时间" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.7"
                               Text="若上一段录音尚未结束下一节课程就已开始，上一段录音会被提前结束并正常保存。" />
                    <Grid ColumnDefinitions="Auto,140,Auto,140,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="上课前提前" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding AdvanceMinutes, Mode=TwoWay}"
                                       Minimum="0" Maximum="120" Increment="1"
                                       FormatString="0" />
                        <TextBlock Grid.Column="2" Text="分钟开始，下课后继续录制" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="3"
                                       Value="{Binding DelayMinutes, Mode=TwoWay}"
                                       Minimum="0" Maximum="120" Increment="1"
                                       FormatString="0" />
                        <TextBlock Grid.Column="4" Text="分钟" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 麦克风 -->
            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="麦克风" FontSize="16" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ComboBox Grid.Column="0"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Microphones}"
                                  SelectedItem="{Binding SelectedMicrophone, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:MicrophoneOption">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Content="刷新列表" Command="{Binding RefreshMicrophonesCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding MicrophoneStatusText}" Opacity="0.7" TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="电平" VerticalAlignment="Center" Opacity="0.7" />
                        <ProgressBar Grid.Column="1"
                                     Minimum="0" Maximum="1"
                                     Value="{Binding AudioLevel}"
                                     Height="8"
                                     VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="试录 10 秒"
                                Command="{Binding StartTestRecordingCommand}"
                                IsEnabled="{Binding CanTestRecord}" />
                        <TextBlock Text="{Binding TestRecordHint}" VerticalAlignment="Center" Opacity="0.7" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleSwitch IsChecked="{Binding Settings.KeepMicrophoneOpen, Mode=TwoWay}" OnContent="" OffContent="" />
                        <TextBlock Text="保持麦克风常开（未录音时也占用设备，可减少开录延迟）"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 编码与质量 -->
            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="编码与质量" FontSize="16" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="Auto,200,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="质量预设" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding QualityOptions}"
                                  SelectedItem="{Binding SelectedQuality, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:QualityOption">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="{Binding EstimatedCapacityText}" Opacity="0.7" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.6"
                               Text="录音以 Opus（Ogg，.opus）格式直接写入最终文件，体积更小、崩溃后更易恢复。" />
                </StackPanel>
            </Border>

            <!-- 写入缓冲 -->
            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="写入缓冲" FontSize="16" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="Auto,160,Auto,160,Auto,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="最大缓冲区大小" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding MaxBufferSizeMb, Mode=TwoWay}"
                                       Minimum="0.1" Maximum="1" Increment="0.1"
                                       FormatString="0.0" />
                        <TextBlock Grid.Column="2" Text="MB，最大缓冲时长" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="3"
                                       Value="{Binding MaxBufferDurationSeconds, Mode=TwoWay}"
                                       Minimum="1" Maximum="60" Increment="1"
                                       FormatString="0" />
                        <TextBlock Grid.Column="4" Text="秒" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap" Opacity="0.7"
                               Text="编码后的音频先保存在内存中，达到任一上限后写入磁盘。意外退出时最多丢失这段缓冲的数据。" />
                </StackPanel>
            </Border>

            <!-- 滚动存储 -->
            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="滚动存储" FontSize="16" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="Auto,180,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="录音目录最大占用" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding MaxTotalSizeMb, Mode=TwoWay}"
                                       Minimum="256" Maximum="1048576" Increment="256"
                                       FormatString="0" />
                        <TextBlock Grid.Column="2" Text="MB（最小 256 MB）" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap" Opacity="0.7"
                               Text="超过上限后，会按录制时间从旧到新自动删除录音文件。" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="{Binding StorageUsageText}" Opacity="0.8" />
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding StorageUsagePercent}"
                                         Height="8" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="刷新"
                                VerticalAlignment="Center"
                                Command="{Binding RefreshStorageUsageCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 开始前提示 -->
            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="开始前提示" FontSize="16" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleSwitch IsChecked="{Binding Settings.PromptBeforeRecording, Mode=TwoWay}" OnContent="" OffContent="" />
                        <TextBlock Text="在开始录制前 5 秒弹出提示浮窗" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
